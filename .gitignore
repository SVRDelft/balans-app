# afhankelijkheden
/node_modules
/.pnp
.pnp.*

# build
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# door Prisma gegenereerd; wordt opnieuw gemaakt door `npm install`
/src/generated/

# de database zelf hoort niet in versiebeheer
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# omgevingsvariabelen — .env bevat het wachtwoord
.env
.env*.local

# door de Prisma CLI geïnstalleerde skills (symlinks, niet overdraagbaar)
/.claude/skills/

# overig
.DS_Store
*.pem
/coverage
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea
