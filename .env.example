# Haal Vercel-variabelen op met: npx vercel env pull .env.local
# Of kopieer dit bestand naar .env.local en vul je eigen waarden in.

# Postgres, bijvoorbeeld Neon via de Vercel Marketplace (pooled adres).
DATABASE_URL="postgresql://gebruiker:wachtwoord@host/database?sslmode=require"
# De Vercel-integratie gebruikt NEON_DATABASE_URL en NEON_DATABASE_URL_UNPOOLED.
# Die hebben voorrang op bovenstaande waarde.

# Optioneel: het directe adres zonder pooler voor Prisma-migraties.
# DATABASE_URL_UNPOOLED="postgresql://gebruiker:wachtwoord@host/database?sslmode=require"

# Het gedeelde wachtwoord waarmee het bestuur inlogt.
APP_WACHTWOORD="verander-dit-wachtwoord"

# Sleutel waarmee het sessiecookie wordt ondertekend. Genereer een eigen waarde,
# bijvoorbeeld met:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="verander-dit-in-een-lange-willekeurige-string"
