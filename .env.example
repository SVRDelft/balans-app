# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en komt dus nooit in git terecht.

# MariaDB. Lokaal start je die met: docker compose up -d
DATABASE_URL="mysql://svr:svr-lokaal@localhost:3306/svr"
# Op de server van de TU Delft staat hier de database uit Plesk, met het
# voorvoegsel svr-bestuur_ in de naam, bijvoorbeeld:
# DATABASE_URL="mysql://svr-bestuur_app:wachtwoord@localhost:3306/svr-bestuur_svr"

# Het gedeelde wachtwoord waarmee het bestuur inlogt. Vervalt zodra de
# persoonlijke accounts met een inloglink per e-mail er zijn (fase 3).
APP_WACHTWOORD="verander-dit-wachtwoord"

# Sleutel waarmee het sessiecookie wordt ondertekend. Genereer een eigen waarde,
# bijvoorbeeld met:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="verander-dit-in-een-lange-willekeurige-string"

# Alleen nodig voor het eenmalig overzetten van de gegevens uit de oude
# Postgres-database (Neon, achter de app op Vercel) naar MariaDB:
#   npx vercel env pull .env.local
# zet NEON_DATABASE_URL klaar, en daarna:
#   npx tsx scripts/postgres-naar-mariadb.mts
# NEON_DATABASE_URL="postgresql://gebruiker:wachtwoord@host/database?sslmode=require"
