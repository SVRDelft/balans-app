className":"binnen","children":[["$","h2",null,{"children":"Ons beleid dit jaar"}],[["$","p","0",{"children":[["$","span","0",{"children":"Het 62e dagelijks bestuur bestaat uit twee personen. Daarom kiezen we scherp: liever zes punten die we aantoonbaar waarmaken dan een lange lijst die halverwege het jaar blijft liggen. Elk punt heeft een controlemoment, en halverwege en aan het eind van het jaar leggen we in de SVR-vergadering verantwoording af."}]]}]],["$","div",null,{"className":"pijlers beleidspunten","children":[["$","div","Transparant over wat de SVR doet",{"children":[["$","h3",null,{"children":"Transparant over wat de SVR doet"}],[["$","p","0",{"children":[["$","span","0",{"children":"Notulen van elke vergadering gaan binnen vijf werkdagen naar alle verenigingen. Van overleg met de TU Delft en de andere koepels geven we in de eerstvolgende SVR-vergadering een terugkoppeling."}]]}]]]}],["$","div","De verenigingen vertegenwoordigen",{"children":[["$","h3",null,{"children":"De verenigingen vertegenwoordigen"}],[["$","p","0",{"children":[["$","span","0",{"children":"Een standpunt dat we namens de verenigingen innemen, stemmen we eerst met ze af. Deelt niet iedereen het, dan zeggen we dat ook, in plaats van een meerderheid als unaniem te presenteren."}]]}]]]}],["$","div","Kennis delen tussen verenigingen",{"children":[["$","h3",null,{"children":"Kennis delen tussen verenigingen"}],[["$","p","0",{"children":[["$","span","0",{"children":"Op elke vergadering is ruimte voor een vereniging die een aanpak of ervaring deelt, zodat niemand het wiel opnieuw hoeft uit te vinden."}]]}]]]}],["$","div","Laagdrempelig contact",{"children":[["$","h3",null,{"children":"Laagdrempelig contact"}],[["$","p","0",{"children":[["$","span","0",{"children":"We komen in de loop van het jaar bij elke vereniging langs, gewoon om elkaar te kennen. Elke dinsdag zijn we op kantoor aan de Van der Burghweg 1, en mail beantwoorden we binnen twee werkdagen."}]]}]]]}],["$","div","Het bestuursjaar aantrekkelijker maken",{"children":[["$","h3",null,{"children":"Het bestuursjaar aantrekkelijker maken"}],[["$","p","0",{"children":[["$","span","0",{"children":"Een bestuursjaar wordt steeds minder aantrekkelijk, en opvolging vinden steeds lastiger. Samen met de andere koepels lobbyen we bij de TU Delft voor betere compensatie, zoals collegegeldvrij besturen en bestuursbeurzen."}]]}]]]}],"$L3"]}]]}]}],"$L4"],["$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":null},{"rsc":"$L10","isPartial":"$@11","staleTime":"$8","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@12","rootVaryParams":null,"needsRuntimeRequest":"$@13"}
