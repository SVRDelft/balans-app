{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon.ico).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon.ico).*)"
        }
      ]
    },
    "/api/bijlagen/[id]": {},
    "/api/export/alles": {
      "maxDuration": 120
    },
    "/api/export/excel": {},
    "/api/export/pdf": {},
    "/api/facturen/[id]/pdf": {},
    "/api/logo": {}
  }
}